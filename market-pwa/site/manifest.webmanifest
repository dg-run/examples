{
  "id": "/app",
  "name": "Tally",
  "short_name": "Tally",
  "description": "Count anything, offline. This example has a store page at the address and the app itself in /app.",
  "categories": ["example", "productivity"],
  "start_url": "/app?source=pwa",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#00747c",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "related_applications": [{ "platform": "webapp", "url": "{{ORIGIN}}/manifest.webmanifest" }]
}
